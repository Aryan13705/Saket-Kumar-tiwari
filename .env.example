# Saket Portfolio — Email Dispatch Environment Configuration
# Copy this file to .env.local and populate the values below.

# 1. Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# 2. Recipient Email Address (where project inquiries will be delivered)
CONTACT_TO_EMAIL=saket.tiwari@example.com

# 3. Verified Sender Address (must be a verified domain in Resend, or onboarding@resend.dev during testing)
CONTACT_FROM_EMAIL=Saket Portfolio <onboarding@resend.dev>
